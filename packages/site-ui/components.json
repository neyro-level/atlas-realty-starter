{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "iconLibrary": "lucide",
  "tailwind": {
    "config": "",
    "css": "src/theme.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "aliases": {
    "components": "#components",
    "utils": "#lib/utils",
    "ui": "#components/ui",
    "lib": "#lib",
    "hooks": "#hooks"
  },
  "registries": {
    "@ams": {
      "url": "https://ui.ams24.ru/r/{name}.json",
      "headers": {
        "Authorization": "Bearer ${AMS_UI_REGISTRY_TOKEN}"
      }
    }
  }
}
