{
  "$schema": "./scripts/starter/starter-manifest.schema.json",
  "version": 1,
  "sourceProject": "ams-realty-platform-starter",
  "targetTemplate": "ams-realty-platform-starter",
  "defaultClassification": "REVIEW_REQUIRED",
  "classifications": [
    {
      "name": "EXCLUDE",
      "patterns": [
        ".env",
        ".env.local",
        ".env.development",
        ".env.test",
        ".env.production",
        ".env.*.local",
        ".git/**",
        ".next/**",
        "node_modules/**",
        "graphify-out/**",
        "outputs/**",
        "test-results/**",
        ".release-artifacts/**",
        "media/**",
        "uploads/**",
        "*.log",
        "*.sqlite",
        "*.sqlite3",
        "c-tmp-*/**",
        ".vscode/**"
      ]
    },
    {
      "name": "ARCHIVE",
      "patterns": [
        "docs/archive/**"
      ]
    },
    {
      "name": "LEGACY_EVIDENCE",
      "patterns": [
        "src/payload/migrations/**"
      ]
    },
    {
      "name": "GENERATED",
      "patterns": [
        "src/payload-types.ts",
        "src/app/(payload)/admin/importMap.js",
        "next-env.d.ts",
        "tsconfig.tsbuildinfo"
      ]
    },
    {
      "name": "OPS_TEMPLATE",
      "patterns": [
        "starter/neutral/deploy/**",
        "starter/neutral/Dockerfile",
        "starter/neutral/docker-compose.yml"
      ]
    },
    {
      "name": "ADAPTER",
      "patterns": [
        "src/payload/public/**",
        "src/payload/admin/queries/**",
        "src/payload/admin/lib/context.ts",
        "src/lib/site-shell.ts"
      ]
    },
    {
      "name": "CORE",
      "patterns": [
        "src/app/**",
        "src/components/**",
        "src/core/**",
        "src/modules/**",
        "src/lib/**",
        "src/shared/**",
        "src/*.ts",
        "src/payload/**",
        "styles/**",
        "public/fonts/**",
        "docs/**",
        "starter/**",
        "tests/**",
        "scripts/**",
        "package.json",
        "pnpm-lock.yaml",
        "next.config.ts",
        "postcss.config.mjs",
        "tsconfig.json",
        "eslint.config.mjs",
        "vitest.config.mts",
        "playwright.config.ts",
        ".node-version",
        ".npmrc",
        ".gitattributes",
        ".gitignore",
        ".graphifyignore",
        "README.md",
        "AGENTS.md",
        "SECURITY.md",
        "docs/ARCHITECTURE.md",
        "docs/FRONTEND_INTEGRATION_CONTRACT.md",
        "docs/RUNBOOK_DEPLOY.md",
        "docs/SECURITY.md",
        "docs/DATA_MODEL.md",
        "docs/PAYLOAD_CONTRACT.md",
        "docs/STARTER_CONTRACT.md",
        "docs/adr/0001-day0.md",
        "*.cjs",
        "*.md",
        "*.json",
        "*.mjs",
        "*.js",
        "*.ts",
        "*.yml",
        "*.yaml",
        ".dockerignore",
        ".env.example",
        ".prettierignore",
        ".prettierrc*",
        "patches/**",
        "types/**",
        "fixtures/**",
        ".sourcecraft/**",
        "src/project/**",
        "deploy/**",
        "Dockerfile",
        "docker-compose.yml",
        "test.env"
      ]
    }
  ],
  "requiredClientReplacements": [
    "future client brand and routes",
    "future public UI library",
    "final deployment identity",
    "feed registry and ownership policy",
    "legal and consent texts",
    "public catalog and indexability policy"
  ],
  "protectedUnionState": [
    "legacy archived docs",
    "retained external runtime evidence",
    "production databases and backups",
    "deployment secrets",
    "release history",
    "technical and primary domains"
  ],
  "audit": {
    "clientMarkers": [],
    "markerAllowedPaths": [],
    "presentationRoots": [
      "src/components",
      "src/modules"
    ],
    "forbiddenPresentationImports": [
      "@/payload",
      "@/project"
    ]
  }
}
