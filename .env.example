# Safe local example. Staging and production use secret storage and HTTPS.
DATABASE_URL=postgres://atlas_realty_starter_local:replace-local-password@127.0.0.1:5435/atlas_realty_starter_dev
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
REVALIDATE_SECRET=replace-with-at-least-32-random-characters

# Production lead delivery. Required in staging and production.
AMS_LEADS_API_URL=
AMS_LEADS_PROJECT_ID=atlas
AMS_LEADS_SITE_KEY=

# Runtime tuning and release identity
APP_ENV=development
DATABASE_POOL_MAX=
RELEASE_SHA=local
SITE_ENGINE=payload

# Public site identity/runtime. A concrete production clone must set these explicitly.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_RELEASE_SHA=local
NEXT_PUBLIC_INDEXABLE=false
NEXT_PUBLIC_NEW_BUILDINGS_MEDIA_BASE_URL=
NEXT_PUBLIC_SITE_MEDIA_BASE_URL=
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Optional outbound image/feed hosts, exact comma-separated hostnames
EXTERNAL_IMAGE_HOSTS=
FEED_OUTBOUND_HOSTS=

# Optional S3 module; set all values together. Required for production media.
S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_REGION=ru-1
S3_SECRET_ACCESS_KEY=

# One-time owner bootstrap command only; do not keep these in a persistent env file.
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_PASSWORD=

postgres
