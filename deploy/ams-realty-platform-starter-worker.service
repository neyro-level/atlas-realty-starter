[Unit]
Description=AMS Realty Platform Starter Payload jobs worker
After=network-online.target ams-realty-platform-starter.service
Wants=network-online.target

[Service]
Type=simple
User=ams-realty-platform-starter
Group=ams-realty-platform-starter
WorkingDirectory=/opt/ams-realty-platform-starter/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PATH=/opt/ams-realty-platform-starter/runtime/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/ams-realty-platform-starter/runtime.env
EnvironmentFile=/etc/ams-realty-platform-starter/release.env
ExecStart=/opt/ams-realty-platform-starter/runtime/bin/pnpm payload jobs:run --cron "* * * * *" --all-queues --handle-schedules
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/ams-realty-platform-starter

[Install]
WantedBy=multi-user.target
