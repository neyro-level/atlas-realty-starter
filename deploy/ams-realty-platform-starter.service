[Unit]
Description=AMS Realty Platform Starter web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ams-realty-platform-starter
Group=ams-realty-platform-starter
WorkingDirectory=/opt/ams-realty-platform-starter/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/ams-realty-platform-starter/runtime.env
EnvironmentFile=/etc/ams-realty-platform-starter/release.env
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3010
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/ams-realty-platform-starter

[Install]
WantedBy=multi-user.target
