[Unit]
Description=AMS Realty Platform Starter web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ams-realty-platform-starter
Group=ams-realty-platform-starter
WorkingDirectory=/opt/ams-realty-platform-starter/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PATH=/opt/ams-realty-platform-starter/runtime/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/ams-realty-platform-starter/runtime.env
EnvironmentFile=/etc/ams-realty-platform-starter/release.env
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3010
Environment=HOME=/opt/ams-realty-platform-starter/shared/home
Environment=TMPDIR=/opt/ams-realty-platform-starter/shared/tmp
ExecStart=/opt/ams-realty-platform-starter/runtime/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ams-realty-platform-starter/shared

[Install]
WantedBy=multi-user.target
