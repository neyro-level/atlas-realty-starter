[Unit]
Description=Atlas Realty web service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=atlas-realty
Group=atlas-realty
WorkingDirectory=/opt/ams-platform/atlas-realty/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PATH=/opt/ams-platform/atlas-realty/runtime/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/ams-platform/atlas-realty/runtime.env
EnvironmentFile=/etc/ams-platform/atlas-realty/release.env
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3010
Environment=HOME=/opt/ams-platform/atlas-realty/shared/home
Environment=TMPDIR=/opt/ams-platform/atlas-realty/shared/tmp
ExecStart=/opt/ams-platform/atlas-realty/runtime/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ams-platform/atlas-realty/shared

[Install]
WantedBy=multi-user.target
