{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMS starter ownership manifest",
  "type": "object",
  "required": ["version", "sourceProject", "targetTemplate", "defaultClassification", "classifications", "audit"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "sourceProject": { "type": "string", "minLength": 1 },
    "targetTemplate": { "type": "string", "minLength": 1 },
    "defaultClassification": { "type": "string", "minLength": 1 },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "patterns"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "patterns": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "requiredClientReplacements": { "type": "array", "items": { "type": "string" } },
    "protectedUnionState": { "type": "array", "items": { "type": "string" } },
    "audit": {
      "type": "object",
      "required": ["clientMarkers", "markerAllowedPaths", "presentationRoots", "forbiddenPresentationImports"],
      "properties": {
        "clientMarkers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "markerAllowedPaths": { "type": "array", "items": { "type": "string" } },
        "presentationRoots": { "type": "array", "items": { "type": "string" } },
        "forbiddenPresentationImports": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
