{
  "name": "soyuz-rostov-next",
  "version": "1.0.0",
  "description": "Foundation проекта Союз Ростов на Next.js 16 и Payload CMS 3",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "db:down": "docker compose down",
    "db:backup:check": "node scripts/verify-backup-restore.mjs",
    "db:migrate:native:check": "node scripts/run-native-integration.mjs --migrate",
    "db:migrate:username-upgrade-check": "node scripts/run-native-integration.mjs --upgrade-auth",
    "db:migrate:production-check": "node scripts/run-native-integration.mjs --production-migrate",
    "db:up": "docker compose up -d postgres",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "fixture:units:benchmark": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node scripts/fixtures/benchmark-unit-catalog.mts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "jobs:run:maintenance": "cross-env NODE_OPTIONS=--no-deprecation payload jobs:run --queue maintenance",
    "jobs:schedule:maintenance": "cross-env NODE_OPTIONS=--no-deprecation payload jobs:handle-schedules --queue maintenance",
    "jobs:run:imports": "cross-env NODE_OPTIONS=--no-deprecation payload jobs:run --queue imports",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "release:pack": "node scripts/build-release-artifact.mjs",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:e2e:production": "cross-env APP_RUNTIME=production NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "verify:payload-upgrade": "pnpm generate:types && pnpm generate:importmap && pnpm lint && pnpm typecheck && pnpm quality:architecture && pnpm build && pnpm test:int && pnpm test:e2e",
    "quality:architecture": "node scripts/quality/architecture.mjs",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:e2e:native": "node scripts/run-native-integration.mjs --e2e",
    "test:e2e:production:native": "node scripts/run-native-integration.mjs --e2e-production",
    "test:int:native": "node scripts/run-native-integration.mjs",
    "starter:audit": "node scripts/starter/audit.mjs --mode source",
    "starter:export": "node scripts/starter/export.mjs",
    "sentry:check": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node scripts/verify-sentry-connection.mts",
    "starter:baseline": "node scripts/starter/create-neutral-baseline.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@sentry/nextjs": "10.73.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.38.0",
    "next": "16.3.0",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "28.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.24.0"
  }
}
