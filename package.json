{
  "name": "atlas-realty-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas demo real-estate product for Krasnodar on Next.js and Payload CMS",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build && node scripts/prepare-standalone.mjs",
    "build:public-env:check": "node scripts/check-public-env-inlined.mjs",
    "visual:baseline": "node scripts/capture-visual-baseline.mjs",
    "ui:shadcn": "node scripts/quality/shadcn-safe.mjs",
    "ui:shadcn:info": "node scripts/quality/shadcn-safe.mjs info --json",
    "ui:typography": "node scripts/quality/typography-contract.mjs",
    "ui:check": "node scripts/quality/ui-system.mjs && pnpm ui:tokens && pnpm ui:typography",
    "ui:check:self-test": "node scripts/quality/ui-system.mjs --self-test && node scripts/quality/typography-contract.mjs --self-test",
    "ui:tokens": "node scripts/quality/token-contract.mjs",
    "db:backup:check": "node scripts/verify-backup-restore.mjs",
    "db:migrate:native:check": "node scripts/run-native-integration.mjs --migrate",
    "db:migrate:roles-check": "node scripts/run-native-integration.mjs --roles-check",
    "db:migrate:stage1-check": "node scripts/run-native-integration.mjs --stage1-migration-check",
    "db:migrate:stage2-check": "node scripts/run-native-integration.mjs --stage2-migration-check",
    "db:migrate:stage3-check": "node scripts/run-native-integration.mjs --stage3-migration-check",
    "benchmark:import:50k": "node scripts/run-native-integration.mjs --stage1-performance",
    "benchmark:public:50k": "node scripts/run-native-integration.mjs --stage2-performance",
    "db:migrate:production-check": "node scripts/run-native-integration.mjs --production-migrate",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:start": "node scripts/local-dev.mjs start",
    "dev:open": "node scripts/local-dev.mjs start --open",
    "dev:status": "node scripts/local-dev.mjs status",
    "dev:stop": "node scripts/local-dev.mjs stop",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "images:optimize": "node scripts/quality/optimize-static-images.mjs",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "jobs:run:maintenance": "cross-env NODE_OPTIONS=--no-deprecation payload jobs:run --queue maintenance",
    "jobs:schedule:maintenance": "cross-env NODE_OPTIONS=--no-deprecation payload jobs:handle-schedules --queue maintenance",
    "jobs:run:imports": "cross-env NODE_OPTIONS=--no-deprecation payload jobs:run --queue imports",
    "jobs:run:leads": "cross-env NODE_OPTIONS=--no-deprecation payload jobs:run --queue lead-deliveries",
    "jobs:schedule:leads": "cross-env NODE_OPTIONS=--no-deprecation payload jobs:handle-schedules --queue lead-deliveries",
    "jobs:run:all": "cross-env NODE_OPTIONS=--no-deprecation payload jobs:run --cron \"* * * * *\" --all-queues --handle-schedules",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "owner:bootstrap": "cross-env NODE_OPTIONS=\"--conditions=react-server --no-deprecation\" tsx scripts/bootstrap-owner.mts",
    "atlas:bootstrap": "cross-env NODE_OPTIONS=\"--conditions=react-server --no-deprecation\" tsx scripts/bootstrap-atlas-demo.mts",
    "atlas:bootstrap:complexes": "cross-env NODE_OPTIONS=\"--conditions=react-server --no-deprecation\" tsx scripts/bootstrap-atlas-complexes.mts",
    "atlas:content:scrape": "node scripts/content/scrape-yandex-realty.mjs",
    "atlas:content:coordinates": "node scripts/content/enrich-yandex-coordinates.mjs",
    "atlas:content:cleanup-media": "cross-env NODE_OPTIONS=\"--conditions=react-server --no-deprecation\" tsx scripts/content/cleanup-orphaned-atlas-media.mts",
    "atlas:content:import:complexes": "cross-env NODE_OPTIONS=\"--conditions=react-server --no-deprecation\" tsx scripts/content/import-atlas-complexes.mts",
    "atlas:content:import:properties": "cross-env NODE_OPTIONS=\"--conditions=react-server --no-deprecation\" tsx scripts/content/import-atlas-properties.mts",
    "atlas:content:verify-live": "node scripts/content/verify-atlas-live.mjs",
    "release:pack": "node scripts/build-release-artifact.mjs",
    "start": "cross-env NODE_OPTIONS=--no-deprecation HOSTNAME=127.0.0.1 node .next/standalone/server.js",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:unit": "vitest run --config ./vitest.unit.config.mts",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "template:profile": "node scripts/template/generate-site-profile.mjs",
    "test:e2e": "node scripts/run-native-integration.mjs --e2e",
    "test:e2e:production": "node scripts/run-native-integration.mjs --e2e-production",
    "test:e2e:production:raw": "cross-env APP_RUNTIME=production NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:e2e:raw": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "verify:payload-upgrade": "pnpm generate:types && pnpm generate:importmap && pnpm lint && pnpm typecheck && pnpm architecture:check && pnpm security:check && pnpm build && pnpm test:int && pnpm test:e2e",
    "architecture:check": "node scripts/quality/architecture.mjs",
    "security:check": "node scripts/quality/security.mjs",
    "test:int": "node scripts/run-native-integration.mjs",
    "test:int:raw": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:int:native": "node scripts/run-native-integration.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm architecture:check && pnpm security:check && pnpm ui:check"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@hookform/resolvers": "5.2.2",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-redirects": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@starter/site-contracts": "workspace:*",
    "@starter/site-fixtures": "workspace:*",
    "@ams/realty-ui": "workspace:*",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "lucide-react": "1.38.0",
    "next": "16.3.4",
    "payload": "3.88.0",
    "pg": "8.23.0",
    "pino": "9.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.62.0",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tsx": "4.22.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "28.0.0",
    "prettier": "3.9.6",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.24.0"
  }
}
